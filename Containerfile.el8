FROM quay.io/rockylinux/rockylinux:8
ENV HOME /
# Use domestic mirrors instead of mirrorlist (see rpmbuild/container/rocky-mirror.repo).
# reposdir makes dnf ignore /etc/yum.repos.d entirely, so repo files added or
# restored by a rocky-repos upgrade are never used.
COPY ./container/rocky-mirror.repo /etc/yum.repos.mirror.d/rocky-mirror.repo
RUN echo 'reposdir=/etc/yum.repos.mirror.d' >> /etc/dnf/dnf.conf
RUN yum update -y && \
    yum install -y \
        autoconf \
        automake \
        bison \
        brotli-devel \
        cmake \
        gcc-c++ \
        git \
        libtool \
        libzstd-devel \
        make \
        openssl-devel \
        perl \
        redhat-rpm-config \
        rpm-build \
        rpmdevtools \
        ruby \
        ruby-devel \
        rubygem-rake \
        systemd-rpm-macros \
        tar \
        zlib-devel \
          && \
    yum clean all && \
    rm -rf /var/cache/yum
RUN rpmdev-setuptree
RUN echo '%dist .el8.jp3cki' >> /.rpmmacros
COPY ./ /rpmbuild/
RUN chown -R root:root /rpmbuild
RUN rpmbuild -ba /rpmbuild/SPECS/h2o.spec
CMD ["/bin/true"]
