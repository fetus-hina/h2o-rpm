%define docroot /var/www

%{?perl_default_filter}
%global __requires_exclude perl\\(VMS|perl\\(Win32|perl\\(Server::Starter

%define gitdate @H2O_GIT_DATE@
%define gitref_l @H2O_GIT_REF@
%define gitref_s @H2O_GIT_REF_SHORT@
%define rebuild @H2O_GIT_DATE_REBUILD@

%define openssl_version @OPENSSL_VERSION@
%define openssl_static 1
%if 0%{?rhel} >= 10
  %define x64_level x86-64-v3
%else
%if 0%{?rhel} >= 9
  %define x64_level x86-64-v2
%else
  %define x64_level x86-64
%endif
%endif

Summary: H2O - The optimized HTTP/1, HTTP/2 server
Name: h2o
Version: 2.3.0
Release: 1.git%{gitdate}.%{rebuild}.%{gitref_s}%{?dist}
URL: https://h2o.examp1e.net/
Source0: h2o-%{gitref_l}.tar.gz
Source1: index.html
Source2: h2o.logrotate
Source4: h2o.service
Source5: h2o.conf
Source6: h2o-tmpfile.conf

Patch2000: h2o-rpm-revision.patch
Patch2001: h2o-openssl-no-engine.patch
Patch2002: h2o-system-ca-bundle.patch
Patch2003: h2o-default-config-path.patch

%if %{openssl_static}
Source1000: h2o-openssl-%{openssl_version}.tar.gz
%endif

License: MIT
Group: System Environment/Daemons
BuildRoot: %{_tmppath}/%{name}-%{version}-%{release}-root
BuildRequires: autoconf
BuildRequires: automake
BuildRequires: bison
BuildRequires: brotli-devel
BuildRequires: cmake >= 2.8
BuildRequires: gcc-c++
BuildRequires: git
BuildRequires: libtool
BuildRequires: libzstd-devel
BuildRequires: openssl-devel
BuildRequires: perl
BuildRequires: pkgconfig
BuildRequires: ruby
BuildRequires: rubygem-rake
BuildRequires: zlib-devel
%if %{openssl_static}
BuildRequires: perl-IPC-Cmd
%endif
Requires: brotli
Requires: ca-certificates
Requires: libzstd
Requires: openssl
Requires: perl-interpreter
Requires(pre): shadow-utils
%if 0%{?rhel} < 9
BuildRequires: systemd-units
%endif
Requires(preun): systemd
Requires(postun): systemd
Requires(post): systemd
Requires(posttrans): systemd
Suggests: h2o-doc = %{version}-%{release}
Suggests: h2o-httpclient


%description
H2O is a very fast HTTP server written in C. It can also be used
as a library.

%package doc
Group: System Environment/Daemons
Summary: H2O - The optimized HTTP/1, HTTP/2 server
BuildArch: noarch

%description doc
Document files for H2O webserver.

%package httpclient
Group: Applications/Internet
Summary: H2O - HTTP/1, HTTP/2 and HTTP/3 client for testing and debugging
Requires: ca-certificates

%description httpclient
h2o-httpclient is a command-line HTTP/1, HTTP/2 and HTTP/3 client built on
libh2o, mainly intended for testing and debugging.



%prep
%setup -q -n h2o-%{gitref_l}
%if 0%{?rhel} >= 10
%patch 2000 -p1
%patch 2001 -p1
%patch 2002 -p1
%patch 2003 -p1
%else
%patch2000 -p1
%patch2001 -p1
%patch2002 -p1
%patch2003 -p1
%endif

# prepare openssl
%if %{openssl_static}
%define openssl_build %{_tmppath}/%{name}-%{version}-%{release}-openssl-build
mkdir -p %{openssl_build}
tar -z -x -f %{SOURCE1000} -C %{openssl_build} --strip-components=1
%endif


%build
# Export distribution build flags so that bundled builds (e.g. mruby) are PIE
# as well (done automatically on el10, but not on el8/el9)
%set_build_flags

# build OpenSSL
%if %{openssl_static}
pushd %{openssl_build}
%define openssl_root %{_tmppath}/%{name}-%{version}-%{release}-openssl-root
./config \
  --release \
  --prefix=%{openssl_root} \
  --libdir=%{openssl_root}/lib \
  --with-rand-seed=getrandom \
  enable-pie \
  no-comp \
  no-shared \
  no-tests \
  no-zlib \
  CFLAGS="%{optflags} -O3 -march=%{x64_level} -mtune=generic -DNDEBUG" \
  CXXFLAGS="%{optflags} -O3 -march=%{x64_level} -mtune=generic -DNDEBUG" \
  LDFLAGS="%{build_ldflags}"
make %{?_smp_mflags}
make install_sw
popd
%endif

# Build H2O
%define cmake_build_flags %{optflags} -O2 -march=%{x64_level} -mtune=generic -fPIE -DH2O_GITREV=%{gitref_s} -DH2O_RPM_REVISION=%{name}-%{version}-%{release}
cmake \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_FLAGS="%{cmake_build_flags}" \
    -DCMAKE_CXX_FLAGS="%{cmake_build_flags}" \
    -DCMAKE_EXE_LINKER_FLAGS="%{build_ldflags}" \
    -DCMAKE_SHARED_LINKER_FLAGS="%{build_ldflags}" \
    -DWITH_BROTLI=on \
    -DWITH_H2OLOG=off \
    -DWITH_MRUBY=on \
    -DWITH_ZSTD=on \
%if %{openssl_static}
    -DOPENSSL_ROOT_DIR=%{openssl_root} \
    -DCMAKE_INCLUDE_PATH=%{openssl_root}/include \
    -DCMAKE_LIBRARY_PATH=%{openssl_root}/lib \
%endif
    -DCMAKE_INSTALL_PREFIX=%{_prefix} \
%if 0%{?rhel} >= 10
    -DZLIB_LIBRARY=%{_libdir}/libz.so.1 \
%endif
    .
make %{?_smp_mflags}

%install
# "make install" rebuilds part of mruby; use the same flags as %%build
%set_build_flags
rm -rf %{buildroot}

make DESTDIR=%{buildroot} install

mkdir -p %{buildroot}%{_sysconfdir}/h2o
install -m 644 -p %{SOURCE5} \
        %{buildroot}%{_sysconfdir}/h2o/h2o.conf

# docroot
mkdir -p %{buildroot}%{docroot}/html
install -m 644 -p %{SOURCE1} \
        %{buildroot}%{docroot}/html/index.html

# Set up /var directories
mkdir -p %{buildroot}%{_localstatedir}/log/h2o

# Install systemd service files
mkdir -p %{buildroot}%{_unitdir}
install -m 644 -p %{SOURCE4} \
        %{buildroot}%{_unitdir}/h2o.service

mkdir -p %{buildroot}/run/h2o
mkdir -p %{buildroot}%{_tmpfilesdir}
install -m 644 -p %{SOURCE6} \
        %{buildroot}%{_tmpfilesdir}/h2o.conf

# install log rotation stuff
mkdir -p %{buildroot}%{_sysconfdir}/logrotate.d
install -m 644 -p %{SOURCE2} \
        %{buildroot}%{_sysconfdir}/logrotate.d/h2o

rm -rf %{buildroot}%{_includedir}/h2o*
rm -rf %{buildroot}%{_includedir}/picotls*
rm -rf %{buildroot}%{_includedir}/quicly*
rm -rf %{buildroot}%{_libdir}/pkgconfig/libh2o*

%pre
getent group h2o >/dev/null || groupadd -r h2o
getent passwd h2o >/dev/null || \
    useradd -r -g h2o -d %{_datadir}/h2o -s /sbin/nologin \
    -c "H2O web server" h2o
exit 0

%post
%systemd_post h2o.service
%tmpfiles_create h2o.conf

%preun
%systemd_preun h2o.service

%postun
%systemd_postun h2o.service

%posttrans
# Gracefully restart a running server so that the new binary is used.
# This is done here rather than in %%postun, because %%postun of the *old*
# package is the one that runs on upgrade. ExecReload validates the
# configuration ("h2o -t") first and does not signal the server if it fails.
if systemctl is-active --quiet h2o.service >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    if ! systemctl reload h2o.service >/dev/null 2>&1; then
        echo "warning: failed to reload h2o.service; the server keeps running with the previous binary and configuration." >&2
        echo "warning: check \"h2o -t -c %{_sysconfdir}/h2o/h2o.conf\" and \"journalctl -u h2o.service\"." >&2
    fi
fi
exit 0

%clean
rm -rf %{buildroot}


%files
%defattr(-,root,root)

%dir %{_sysconfdir}/h2o
%config(noreplace) %{_sysconfdir}/h2o/h2o.conf
%config(noreplace) %{_sysconfdir}/logrotate.d/h2o

%{_unitdir}/h2o.service
%{_tmpfilesdir}/h2o.conf

%{_bindir}/h2o
%{_datadir}/h2o
%{_mandir}/man*/h2o*
%exclude %{_bindir}/h2olog
%exclude %{_libdir}/libh2o-evloop.a

%dir %{docroot}
%dir %{docroot}/html
%config(noreplace) %{docroot}/html/index.html

%ghost %attr(0770,root,h2o) %dir /run/h2o
%attr(0700,root,root) %dir %{_localstatedir}/log/h2o


%files doc
%{_defaultdocdir}/h2o

%files httpclient
%{_bindir}/h2o-httpclient


%changelog
